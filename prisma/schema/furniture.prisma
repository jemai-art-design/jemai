model Furniture {
  id            String @id @default(uuid(7))
  slug          String @unique
  name          String
  category      String
  price         Int
  stock         Int    @default(0)
  summary       String @db.Text
  description   String @db.Text
  timeline      String @db.Text
  customization String @db.Text

  /// The one shot that stands for the whole product — checkout lines, social
  /// cards, the console's index. Everything else a buyer looks at hangs off the
  /// variant they picked, not off here.
  thumbnail String?

  variants FurnitureVariant[]
  orders   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([updatedAt])
  @@map("furniture")
}

model FurnitureVariant {
  id          String    @id @default(uuid(7))
  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)

  size   String @default("")
  colour String

  /// Overrides the product's price for this combination. Null is the common
  /// case — the variant sells at whatever the product costs.
  price Int?

  quantity Int @default(0)

  /// What the detail frame draws once this combination is picked: between one
  /// and three sources, the first of which is the main shot. Enforced by the
  /// form and its payload schema rather than by the column, which cannot count.
  images String[] @default([])

  position Int @default(0)

  orders OrderItem[]

  @@index([furnitureId])
  @@map("furniture_variants")
}
